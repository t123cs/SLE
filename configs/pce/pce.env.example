# Copy this file and edit paths before running the PCE examples.

PYTHON_BIN=python
BEIR_DATA_ROOT=/path/to/prepared/beir
LLAMA31_8B_INSTRUCT=/path/to/Meta-Llama-3.1-8B-Instruct
D2QPP_EMBEDDING_MODEL_PATH=/path/to/all-MiniLM-L6-v2
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=/path/to/Meta-Llama-3.1-8B-Instruct

BENCHMARK_OUTPUT_ROOT=results/pce_smoke
LIMIT_DOCS=50
WARMUP_DOCS=1

RUN_D2QPP_FULL=0
RUN_D2QPP_QGEN_ONLY=1
RUN_SDE_TRACE=1
